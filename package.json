{
  "name": "dsh-mermaid-plus",
  "version": "0.4.5",
  "description": "Mermaid 12 ELK diagrams for DSH 0.2.2-rc.1 with inline wheel zoom, pan and SVG/PNG export.",
  "license": "MIT",
  "author": "pidongqianqian",
  "type": "module",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mermaid",
    "diagram",
    "flowchart",
    "markdown",
    "sequence-diagram"
  ],
  "homepage": "https://github.com/Songyanglin-curious/dsh-mermaid-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Songyanglin-curious/dsh-mermaid-plus.git"
  },
  "bugs": {
    "url": "https://github.com/Songyanglin-curious/dsh-mermaid-plus/issues"
  },
  "meta": {
    "title": "Mermaid Diagrams Plus",
    "description": "Renders Mermaid diagrams with ELK layouts when they scroll into view, with theme-aware colours, wheel zoom, drag to pan, fullscreen viewing and SVG/PNG export."
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "vendor/mermaid.esm.min.mjs",
    "vendor/mermaid.LICENSE",
    "vendor/elkjs.LICENSE",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run.mjs",
    "test:e2e": "node test/serve-e2e.mjs",
    "dev": "node tools/dev-sync.mjs",
    "doctor": "node tools/doctor.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "mermaid": "12.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
